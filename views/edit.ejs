<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src = "https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full min-h-screen p-10">
        <h1>Edit filename</h1>
        <form action="/edit" method="post" class="flex flex-col">
            <input class="w-80 mt-5 p-2 rounded-md" readonly value="<%= filename %>" name="previous">
            <input class="w-80 mt-5 p-2 rounded-md text-white placeholder-gray-100" placeholder="Enter new name" name="new">
            <button class="w-32 mt-5 p-2 rounded-md bg-yellow-400" type="submit">Change name</button>
        </form>
    </div>
</body>
</html>
