<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src = "https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="w-full min-h-screen p-10">
        <form action="/delete" method="post" class="w-80 rounded-md p-3 items-center bg-zinc-800">
            <h2><%= filename %> will be deleted permanently.Are you sure you want to proceed further?</h2>
            <input type="hidden" name="deletefile" value="<%= filename %>">
            <div class="flex justify-between gap-6">
                <a class="p-2 text-zinc-400" href="/">Cancel</a>
                <button class="p-2 text-red-400" type="submit">Delete</button>
            </div>
        </form>
    </div>
</body>
</html>